-- Sign-out wipes the viewer's data. Profiles and tombstones are public facts and stay: dropping the
-- tombstones would bring back posts that their authors deleted, from relays that ignore NIP-09.
clearUserData {
    DELETE FROM post;
    DELETE FROM revision;
    DELETE FROM reaction;
    DELETE FROM replaceable_version;
    DELETE FROM follow;
    DELETE FROM bookmark;
    DELETE FROM relay;
    DELETE FROM trending;
    DELETE FROM sync_state;
    DELETE FROM video_list;
    DELETE FROM video_like;
    DELETE FROM video_comment;
    DELETE FROM report;
    DELETE FROM chat_reaction;
    DELETE FROM verified_contact;
    DELETE FROM blocked;
    DELETE FROM mute_list;
    DELETE FROM chat_message;
    DELETE FROM chat;
}
