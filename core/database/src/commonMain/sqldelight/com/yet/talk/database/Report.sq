-- NIP-56 reports: the viewer's own, and those made by people they follow (fetched by ModerationRepositoryImpl).
CREATE TABLE report (
    event_id TEXT NOT NULL PRIMARY KEY,
    reporter TEXT NOT NULL,
    target_pubkey TEXT NOT NULL,
    target_event TEXT,
    type TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE INDEX report_reporter ON report(reporter);

insertReport:
INSERT OR IGNORE INTO report(event_id, reporter, target_pubkey, target_event, type, created_at) VALUES (?, ?, ?, ?, ?, ?);

-- Posts reported by the viewer or by someone they follow.
selectHiddenPosts:
SELECT DISTINCT r.target_event FROM report r
WHERE r.target_event IS NOT NULL
  AND (r.reporter = :viewer OR r.reporter IN (SELECT f.followee FROM follow f WHERE f.follower = :viewer));
