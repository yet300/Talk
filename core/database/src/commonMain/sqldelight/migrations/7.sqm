-- Version 7 → 8: chats in full (groups, replies, reactions, files, disappearing messages, blocks).
ALTER TABLE chat ADD COLUMN name_enc TEXT;
ALTER TABLE chat ADD COLUMN muted INTEGER NOT NULL DEFAULT 0;
ALTER TABLE chat ADD COLUMN hidden INTEGER NOT NULL DEFAULT 0;
ALTER TABLE chat ADD COLUMN expire_seconds INTEGER;

ALTER TABLE chat_message ADD COLUMN kind INTEGER NOT NULL DEFAULT 14;
ALTER TABLE chat_message ADD COLUMN reply_to TEXT;
ALTER TABLE chat_message ADD COLUMN expires_at INTEGER;
ALTER TABLE chat_message ADD COLUMN removed INTEGER NOT NULL DEFAULT 0;

CREATE TABLE chat_reaction (
    message_id TEXT NOT NULL,
    author TEXT NOT NULL,
    emoji TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (message_id, author)
);

CREATE TABLE blocked (
    owner TEXT NOT NULL,
    pubkey TEXT NOT NULL,
    PRIMARY KEY (owner, pubkey)
);

CREATE TABLE mute_list (
    owner TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    event_json TEXT NOT NULL
);
